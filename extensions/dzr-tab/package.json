{
  "name": "@dzr-tab/dzr-tab",
  "version": "3.0.0",
  "private": true,
  "description": "Discover a Deezer track every time you open a new tab.",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox"
  },
  "dependencies": {
    "@dzr-tab/deezer-api": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "node-vibrant": "^4.0.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "^5.5.0",
    "wxt": "^0.19.0"
  }
}
